# Copier vers ~/.openclaw/workspace/.env.dealhunter puis chmod 600. Ne jamais committer le vrai fichier.
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_NOUVELLE_CLE
TRAVELPAYOUTS_TOKEN=NOUVEAU_TOKEN
TELEGRAM_BOT_TOKEN=NOUVEAU_TOKEN_BOT
TELEGRAM_CHAT_ID=VOTRE_CHAT_ID

# Réglages facultatifs (valeurs par défaut du robot entre parenthèses). Ne les définir que pour les changer.
# MIN_DISCOUNT_PCT=15       (remise minimale pour publier un deal)
# MAX_PER_DESTINATION=3     (nombre maximum de deals par destination)
# BENCHMARK_FACTOR=1.25     (coefficient appliqué aux prix de référence ; 1.0 = prix de la table tels quels)
